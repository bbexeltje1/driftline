-- Network contracts: event IDs, plausibility envelopes, duplicate guards.
assert(NetworkContracts.isValidEventId("abc-123"), "valid event id")
assert(not NetworkContracts.isValidEventId(""), "empty id rejected")
assert(not NetworkContracts.isValidEventId(123), "non-string id rejected")
assert(NetworkContracts.isValidTrickId("Meteor"), "Meteor valid")
assert(not NetworkContracts.isValidTrickId("Fly"), "unknown trick rejected")
assert(NetworkContracts.isValidItemId("Arcboard"), "board valid")
assert(not NetworkContracts.isValidItemId("Jetpack"), "unknown item rejected")
assert(NetworkContracts.isPlausibleAirTime(1.0), "1s air plausible")
assert(not NetworkContracts.isPlausibleAirTime(0.05), "too-short air rejected")
assert(not NetworkContracts.isPlausibleAirTime(9), "too-long air rejected")
assert(NetworkContracts.isPlausibleYaw(180, 1.0), "180deg in 1s plausible")
assert(not NetworkContracts.isPlausibleYaw(900, 1.0), "900deg in 1s impossible")
assert(NetworkContracts.isPlausibleSpeed(40), "40 speed plausible")
assert(not NetworkContracts.isPlausibleSpeed(500), "500 speed impossible")
assert(not NetworkContracts.isPlausibleSpeed(-5), "negative speed rejected")
print("PASS Contracts: ids/envelopes")
