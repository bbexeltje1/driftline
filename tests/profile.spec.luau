-- Session profile: grant-once, insufficient funds, unlock/equip validation.
local profile = Profile.new(123)
assert(profile.tokens == 0, "starts broke")
assert(profile.owned.Trailboard, "owns starter board")
assert(Profile.grantForRun(profile, "run-A", 0, 60) == 120, "first grant 120")
assert(Profile.grantForRun(profile, "run-A", 0, 60) == 0, "duplicate run grant blocked")
assert(profile.tokens == 120, "tokens credited once")
assert(not Profile.unlock(profile, "Arcboard"), "insufficient funds rejected (150 > 120)")
assert(Profile.unlock(profile, "DuskStripe"), "cheapest unlock succeeds")
assert(profile.tokens == 20, "tokens deducted once")
assert(not Profile.unlock(profile, "DuskStripe"), "re-unlock rejected (idempotent)")
assert(Profile.equip(profile, "cosmetic", "DuskStripe"), "equip owned cosmetic")
assert(not Profile.equip(profile, "board", "DuskStripe"), "wrong slot rejected")
assert(not Profile.equip(profile, "board", "Arcboard"), "unowned equip rejected")
assert(Profile.grantForRun(profile, "run-B", 600, 50) == 150, "second run grant")
assert(Profile.unlock(profile, "Arcboard"), "board unlock after earnings")
assert(Profile.equip(profile, "board", "Arcboard"), "equip board")
local stats = Profile.boardStats(profile)
assert(stats.turnRate > 2.4, "Arcboard turns sharper")
assert(stats.maxSpeed < 62, "Arcboard trades top speed")
assert(not Profile.unlock(profile, "Nope"), "unknown item rejected")

print("PASS Profile: grant-once/unlock/equip/sidegrade")
